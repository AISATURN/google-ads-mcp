# Google Ads API credentials
# See README.md for how to obtain each of these values.

# Developer token from your Google Ads Manager (MCC) account → API Center (required)
GOOGLE_ADS_DEVELOPER_TOKEN=

# OAuth2 client credentials from Google Cloud Console → APIs & Services → Credentials (required)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# OAuth2 refresh token with https://www.googleapis.com/auth/adwords scope (required)
GOOGLE_ADS_REFRESH_TOKEN=

# Manager (MCC) account ID, digits only, used as login-customer-id when operating on
# client accounts under a manager. Optional — leave blank if you authenticate directly
# as the advertising account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Default advertising account (customer) ID, digits only (e.g. 1234567890).
# Optional — if set, tools use it when no customer_id argument is provided.
GOOGLE_ADS_CUSTOMER_ID=

# --- Remote deployment only (Vercel + claude.ai Custom Connector) ---
# Not needed for local stdio use. See README.md "Remote deployment" section.

# Password gate for the /api/authorize login page. Use a long random string
# (not a memorized phrase) — generate with: openssl rand -base64 24
MCP_OWNER_PASSWORD=

# Secret used to sign/verify all OAuth JWTs (auth codes, access + refresh
# tokens). Generate with: openssl rand -base64 32
# Rotating this value immediately revokes all outstanding tokens.
MCP_JWT_SECRET=

# The public base URL of this deployment, no trailing slash
# (e.g. https://your-project.vercel.app). Used as the OAuth issuer/audience.
MCP_PUBLIC_URL=
