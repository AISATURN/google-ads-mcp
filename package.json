{
  "name": "google-ads-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for creating and managing Google Ads campaigns via the Google Ads API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-ads-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-ads",
    "advertising",
    "campaigns"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "google-ads-api": "^23.0.1",
    "jose": "^6.2.3",
    "zod": "^3.25.76"
  }
}
